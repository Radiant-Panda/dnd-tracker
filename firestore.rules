rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // GM: full read/write to their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Players must be signed in (even anonymously) to read campaign/character data
    match /users/{gmId}/campaigns/{campaignId} {
      allow read: if request.auth != null;
    }
    match /users/{gmId}/characters/{charId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.shareToken != null
                    && request.resource.data.shareToken == resource.data.shareToken;
    }
  }
}
