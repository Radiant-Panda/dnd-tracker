rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // GM: full access to own data (covers all reads/writes for authenticated owner)
    match /users/{gmId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == gmId;
    }

    // Player view + setup view: single-document reads of a campaign by known ID.
    // "get" only — prevents listing all campaigns across users.
    match /users/{gmId}/campaigns/{campaignId} {
      allow get: if request.auth != null;

      // Setup view: can only append a character ID to the characters array.
      // The setupToken must already exist on the document and must not be changed.
      // No other fields may be modified.
      allow update: if request.auth != null
                    && resource.data.setupToken != null
                    && request.resource.data.setupToken == resource.data.setupToken
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['characters'])
                    && (resource.data.characters == null
                        || request.resource.data.characters.hasAll(resource.data.characters));
    }

    // Player view + setup view: single-document reads/writes on characters.
    // "get" only — prevents listing all characters across users.
    match /users/{gmId}/characters/{charId} {

      // Only readable if the GM has explicitly enabled sharing on this character.
      allow get: if request.auth != null && resource.data.shareToken != null;

      // Setup view: create a new character. Must include a shareToken.
      allow create: if request.auth != null
                    && request.resource.data.shareToken != null;

      // Player view: full character update. shareToken and id must not change.
      allow update: if request.auth != null
                    && resource.data.shareToken != null
                    && request.resource.data.shareToken == resource.data.shareToken
                    && request.resource.data.id == resource.data.id;
    }

    // Companions: the shareable part of an NPC plus its play state, run by the owning player.
    // "get" only (no listing). What a player may change depends on the GM's playerAccess setting:
    //   'view' — nothing; 'play' — HP, temp HP, conditions, uses and art; 'full' — also stats and names.
    // Links (owner, NPC, campaign), the share token and playerAccess itself are GM-only.
    match /users/{gmId}/companions/{companionId} {
      function playFields() {
        return ['hp', 'tempHP', 'conditions', 'uses', 'portrait', 'portraitZoom', 'portraitX', 'portraitY'];
      }
      function fullFields() {
        return playFields().concat(['name', 'role', 'race', 'location', 'ac', 'maxHP', 'initBonus',
                                    'statBlock', 'statSource', 'legendaryMax']);
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      allow get: if request.auth != null && resource.data.shareToken != null;

      allow update: if request.auth != null
                    && resource.data.shareToken != null
                    && ((resource.data.playerAccess == 'play' && changed().hasOnly(playFields()))
                        || (resource.data.playerAccess == 'full' && changed().hasOnly(fullFields())))
                    && request.resource.data.hp is number
                    && request.resource.data.hp >= 0
                    && request.resource.data.hp <= request.resource.data.maxHP
                    && request.resource.data.tempHP is number
                    && request.resource.data.tempHP >= 0
                    && (!('portrait' in request.resource.data) || request.resource.data.portrait == null
                        || (request.resource.data.portrait is string && request.resource.data.portrait.size() < 300000));
    }

  }
}
